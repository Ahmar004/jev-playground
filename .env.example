# ---------------------------------------------------------------------------
# 8x web template — environment variables
#
# Copy this file to .env.local for local dev (never commit a populated env
# file — .gitignore blocks .env* except this file). Every variable below is
# validated at boot in src/lib/env.ts (Zod), which actually runs — wired
# into instrumentation.ts's register() — so a misconfigured deployment
# fails immediately with a clear message instead of surfacing as an
# obscure runtime error three requests later. If you add a new
# process.env.X reference anywhere in the app, add it here AND to that
# schema — `pnpm check:env` fails the build if the two drift apart.
# ---------------------------------------------------------------------------

# --- Database: Vercel + local + CI ------------------------------------------
# App runtime connection — MUST use the pooler (transaction mode, port 6543)
# so serverless functions don't exhaust Postgres connections. Required in
# every environment, including Vercel.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# --- Database: local + GitHub Actions ONLY — never add these to Vercel ------
# Everything in this block is read by the Prisma CLI, never by the running
# app. `prisma generate` is the ONE Prisma command that does not need them,
# and it is the only Prisma command a Vercel build runs — so a deployment
# succeeds with them missing, and they can sit unused in a Vercel project for
# months without anything failing. Setting them there puts a full-DDL
# `postgres` credential in the app's runtime environment for no function.

# Migration connection — MUST use the direct/session connection (port 5432).
# `prisma migrate deploy` holds an advisory lock across statements that a
# transaction-mode pooler (6543) cannot sustain — using the pooler here is
# the single most common cause of migrations silently hanging in CI.
# Optional in src/lib/env.ts's schema on purpose: only the Prisma CLI reads
# it (migrate dev/deploy) and the run-once SQL runner (`pnpm db:run-once`,
# which falls back to DATABASE_URL), never the running app.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Auth (Supabase) --------------------------------------------------------
# Auth ONLY — application data still goes through Prisma/DATABASE_URL, never
# a Supabase query. See docs/rules/auth.md. A pure landing page removes this
# entire section, the @supabase/* dependencies, and proxy.ts's session-
# refresh logic. All three vars are optional in src/lib/env.ts's schema so
# a landing-page clone still boots without them.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Supabase's new-style keys (sb_publishable_… / sb_secret_…), NOT the legacy
# anon / service_role JWTs — those are being disabled on every project.
# The secret key is server-only, bypasses auth entirely — never exposed to
# the client, never used for anything but admin auth operations (see
# src/lib/supabase/secret-key.ts).
SUPABASE_SECRET_KEY=""

# --- Logging ---------------------------------------------------------------
# Minimum severity the server logger writes to stdout (structured JSON, one
# line per event — see docs/rules/logging.md). One of: debug | info | warn |
# error | silent. Optional; defaults to `info` (or `silent` under tests).
LOG_LEVEL=""

# --- Sentry --------------------------------------------------------------
# Client + server error tracking. Falls back to a silent no-op if unset in
# development; CI build will warn (not fail) if unset since Sentry is not
# required to build, only to report — but production deploys should always
# have this set.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Auth token for uploading source maps at build time — CI/Vercel only,
# never needed for local dev. Generate from Sentry -> Settings -> Auth Tokens.
SENTRY_AUTH_TOKEN=""

# --- PostHog (product analytics) -----------------------------------------
# Client-side capture key — safe to expose, this is the public write-only key.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Attached as the app_version property on every analytics event (optional —
# events just omit it if unset). Wire it to your build's version/commit in CI,
# e.g. NEXT_PUBLIC_APP_VERSION="$VERCEL_GIT_COMMIT_SHA". See docs/rules/analytics.md.
NEXT_PUBLIC_APP_VERSION=""
