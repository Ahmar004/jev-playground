{
	"name": "jevs-playground",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.6.2",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint . --max-warnings=0",
		"typecheck": "next typegen && tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --test \"scripts/*.test.mjs\" \"src/**/*.test.mts\" && vitest run",
		"test:e2e": "playwright test",
		"record": "tsx --env-file-if-exists=.env.local scripts/record.ts",
		"load:session": "node load/session.mjs",
		"load": "k6 run -q load/journey.js",
		"prisma:generate": "prisma generate",
		"prisma:migrate:generate:check": "node scripts/generate-migration.mjs --check",
		"db:run-once": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/run-once-sql.mjs",
		"check:env": "node scripts/check-env-vars.mjs",
		"check:secrets": "node scripts/check-secrets.mjs --all",
		"check:standards": "node scripts/check-standards.mjs",
		"check:rls": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/check-rls.mjs",
		"prepare": "git config core.hooksPath .githooks",
		"postinstall": "prisma generate"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@phosphor-icons/react": "^2.1.10",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-slider": "^1.4.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-switch": "^1.3.7",
		"@radix-ui/react-tabs": "^1.1.21",
		"@radix-ui/react-toast": "^1.2.23",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@sentry/nextjs": "^10.76.0",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.112.3",
		"@tanstack/react-query": "^5.101.4",
		"canvas-confetti": "^1.9.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"motion": "^13.4.6",
		"next": "^16.3.8",
		"next-themes": "^0.4.6",
		"pino": "^10.3.1",
		"posthog-js": "^1.435.8",
		"posthog-node": "^5.48.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-error-boundary": "^6.1.3",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^22.20.4",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^9",
		"eslint-config-next": "^16.3.0",
		"jsdom": "^30.1.1",
		"prettier": "^3",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"prisma": "^7.10.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^5.8.3",
		"vitest": "^5.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/client",
			"@prisma/engines",
			"@sentry/cli",
			"@swc/core",
			"prisma",
			"unrs-resolver"
		]
	}
}
